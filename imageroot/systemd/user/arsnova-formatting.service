# ARSnova formatting service (Markdown/LaTeX rendering for content and answers).
# Node service listening on port 3000. Reachable inside the network as
# "arsnova-formatting-service".

[Unit]
Description=ARSnova formatting service
BindsTo=arsnova.service
After=arsnova.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/arsnova-formatting.pid %t/arsnova-formatting.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/arsnova-formatting.pid \
    --cidfile %t/arsnova-formatting.ctr-id \
    --cgroups=no-conmon \
    --network arsnova \
    --replace -d --name arsnova-formatting-service \
    --env SERVER_PORT=3000 \
    ${ARSNOVA_SERVER_FORMATTING_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/arsnova-formatting.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/arsnova-formatting.ctr-id
PIDFile=%t/arsnova-formatting.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
