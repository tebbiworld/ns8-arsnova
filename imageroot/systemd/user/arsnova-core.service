# ARSnova backend core: rooms, contents, answers and the live socket.io stream.
# Talks to CouchDB and RabbitMQ, formats text via the formatting service and
# sends registration/verification mail through the cluster smarthost (the
# SYSTEM_MAIL_* variables are provided by state/smarthost.env, refreshed by the
# discover-smarthost helper). Reachable inside the network as
# "arsnova-backend-core".

[Unit]
Description=ARSnova backend core
BindsTo=arsnova.service
After=arsnova.service arsnova-couchdb.service arsnova-rabbitmq.service arsnova-formatting.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/arsnova-core.pid %t/arsnova-core.ctr-id
# Make sure the SMTP env file exists before it is referenced below.
ExecStartPre=/bin/touch %S/state/smarthost.env
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/arsnova-core.pid \
    --cidfile %t/arsnova-core.ctr-id \
    --cgroups=no-conmon \
    --network arsnova \
    --replace -d --name arsnova-backend-core \
    --env-file %S/state/smarthost.env \
    --env SYSTEM_API_PROXYPATH=/api \
    --env SYSTEM_ROOT_URL=${ARSNOVA_ROOT_URL} \
    --env SYSTEM_SOCKETIO_BINDADDRESS=0.0.0.0 \
    --env SYSTEM_COUCHDB_HOST=couchdb \
    --env SYSTEM_COUCHDB_USERNAME=${COUCHDB_USER} \
    --env SYSTEM_COUCHDB_PASSWORD=${COUCHDB_PASSWORD} \
    --env SYSTEM_COUCHDB_CREATEDB=true \
    --env SYSTEM_MESSAGE_BROKER_RABBITMQ_ENABLED=true \
    --env SYSTEM_MESSAGE_BROKER_RABBITMQ_HOST=rabbitmq \
    --env SYSTEM_MESSAGE_BROKER_RABBITMQ_USERNAME=guest \
    --env SYSTEM_MESSAGE_BROKER_RABBITMQ_PASSWORD=guest \
    --env SYSTEM_MESSAGE_BROKER_RABBITMQ_VIRTUAL_HOST=/ \
    --env SYSTEM_FORMATTING_SERVICE_HOST_URL=http://arsnova-formatting-service:3000 \
    --env SECURITY_JWT_SECRET=${JWT_SECRET} \
    --env SECURITY_JWT_SERVER_ID=arsnova.backend.v3:${TRAEFIK_HOST} \
    --env SECURITY_ADMIN_ACCOUNTS_0=${ADMIN_ACCOUNT} \
    ${ARSNOVA_SERVER_CORE_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/arsnova-core.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/arsnova-core.ctr-id
PIDFile=%t/arsnova-core.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
