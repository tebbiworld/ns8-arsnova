# ARSnova front reverse proxy (nginx). This is the ONLY container published to
# the host. It serves the web client at "/", forwards "/api/" to the HTTP
# gateway and "/api/ws/" to the websocket gateway (with WebSocket upgrade
# headers). Traefik routes the public host name to the port published here and
# transparently forwards the WebSocket upgrade.
#
# net.ipv4.ip_unprivileged_port_start=0 lets the in-container nginx bind port 80
# even if it drops privileges.
#
# The nginx config template is an adapted copy mounted over the image default
# (etc/arsnova-proxy.conf.template): it pins X-Forwarded-Proto/-Port towards the
# websocket gateway to this instance's public scheme/port, written to
# state/proxy.env by bin/discover-proxy-scheme. Without it the gateway's SockJS
# same-origin check rejects the browser handshake with 403 behind TLS and the
# live/focus features fail silently.

[Unit]
Description=ARSnova proxy
BindsTo=arsnova.service
After=arsnova.service arsnova-web.service arsnova-gateway.service arsnova-websocket.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/arsnova-proxy.pid %t/arsnova-proxy.ctr-id
# Write state/proxy.env (PUBLIC_FORWARDED_PROTO/PORT) from this instance's
# public scheme, read again below for --env-file. Scheme detection cannot fail
# the start; an unwritable state dir would, which beats a broken config.
ExecStartPre=/usr/local/bin/runagent discover-proxy-scheme
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/arsnova-proxy.pid \
    --cidfile %t/arsnova-proxy.ctr-id \
    --cgroups=no-conmon \
    --network arsnova \
    --replace -d --name arsnova-proxy \
    --publish 127.0.0.1:${TCP_PORT}:80 \
    --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    --volume %S/etc/arsnova-proxy.conf.template:/etc/nginx/templates/arsnova.conf.template:ro,Z \
    --env ARSNOVA_HOSTNAME=${TRAEFIK_HOST} \
    --env CSP_FRAME_ANCESTORS='self' \
    --env-file %S/state/proxy.env \
    ${ARSNOVA_PROXY_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/arsnova-proxy.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/arsnova-proxy.ctr-id
PIDFile=%t/arsnova-proxy.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
