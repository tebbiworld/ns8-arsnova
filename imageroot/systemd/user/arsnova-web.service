# ARSnova Angular web client (static frontend served by nginx). It fetches its
# runtime configuration from /api at load time, so it needs no build-time or
# environment configuration here. Reachable inside the network as "arsnova-web".

[Unit]
Description=ARSnova web client
BindsTo=arsnova.service
After=arsnova.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/arsnova-web.pid %t/arsnova-web.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/arsnova-web.pid \
    --cidfile %t/arsnova-web.ctr-id \
    --cgroups=no-conmon \
    --network arsnova \
    --replace -d --name arsnova-web \
    ${ARSNOVA_WEBCLIENT_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/arsnova-web.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/arsnova-web.ctr-id
PIDFile=%t/arsnova-web.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
