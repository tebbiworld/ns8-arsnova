# ARSnova authentication/authorization service (authz). Issues and validates
# the JWTs used across the stack. Reachable inside the arsnova network as
# "arsnova-auth-service".
#
# GOTCHA (3.13): authz needs BOTH SECURITY_JWT_SECRET and SECURITY_JWT_SERVER_ID.
# Without the server id it crash-loops at boot ("security.jwt ... serverId is
# null"), pegging the CPU. Keep both in sync with core and gateway.

[Unit]
Description=ARSnova auth service
BindsTo=arsnova.service
After=arsnova.service arsnova-postgres-auth.service arsnova-rabbitmq.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/arsnova-authz.pid %t/arsnova-authz.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/arsnova-authz.pid \
    --cidfile %t/arsnova-authz.ctr-id \
    --cgroups=no-conmon \
    --network arsnova \
    --replace -d --name arsnova-auth-service \
    --env SERVER_PORT=8080 \
    --env SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql_auth:5432/arsnovaauth \
    --env SPRING_DATASOURCE_USERNAME=${PG_AUTH_USER} \
    --env-file %S/state/secrets/authz.env \
    --env SPRING_JPA_HIBERNATE_DDL_AUTO=update \
    --env RABBITMQ_HOST=rabbitmq \
    --env RABBITMQ_USERNAME=guest \
    --env RABBITMQ_PASSWORD=guest \
    --env SECURITY_JWT_SERVER_ID=arsnova.backend.v3:${TRAEFIK_HOST} \
    ${ARSNOVA_SERVER_AUTHZ_IMAGE} /jetty/start.jar --module=http-forwarded
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/arsnova-authz.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/arsnova-authz.ctr-id
PIDFile=%t/arsnova-authz.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
