# The core's update-module action does not restart the module's units, so unit
# or config changes would only apply at the next reboot. The core regenerates
# its directory login settings (bin/discover-ldap) when it starts. When the
# pasta options of the module user change (node loopback for a user domain),
# every container is stopped first so podman creates a new rootless network.

import os
import subprocess
import sys

import agent
import arsnovaldap

sys.stdout = sys.stderr  # any output goes to the journal

UNITS = [
    "arsnova.service", "arsnova-couchdb.service", "arsnova-postgres-auth.service",
    "arsnova-postgres-comment.service", "arsnova-rabbitmq.service", "arsnova-authz.service",
    "arsnova-core.service", "arsnova-comments.service", "arsnova-websocket.service",
    "arsnova-formatting.service", "arsnova-web.service", "arsnova-gateway.service",
    "arsnova-proxy.service",
]

# the environment of this process predates 04migrate_ldap
os.environ.update(agent.read_envfile("environment"))

subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
if arsnovaldap.configure_host_loopback():
    print("rootless network options changed: stopping every container first")
    subprocess.run(["systemctl", "--user", "stop"] + UNITS, check=True)
    subprocess.run(["systemctl", "--user", "start"] + UNITS, check=True)
else:
    subprocess.run(["systemctl", "--user", "restart", "arsnova.service", "arsnova-core.service"], check=True)
