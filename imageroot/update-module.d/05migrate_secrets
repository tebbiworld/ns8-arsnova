# Up to 1.1.1 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600) and render the per-container secret files; the
# values do not change.

import os

import modsecrets
import servicesecrets

modsecrets.migrate_from_env(
    ["JWT_SECRET", "COUCHDB_PASSWORD", "PG_AUTH_PASSWORD", "PG_COMMENT_PASSWORD", "LDAP_BIND_PASSWORD"])
servicesecrets.render()

# these generated files carry a password too
state = os.environ["AGENT_STATE_DIR"]
for name in ("ldap.env", "smarthost.env", "admin.env"):
    path = os.path.join(state, name)
    if os.path.exists(path):
        os.chmod(path, 0o600)
