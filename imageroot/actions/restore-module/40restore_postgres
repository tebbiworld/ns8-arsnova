# Rebuild both PostgreSQL data directories from the pg_dump files restored into
# state/pgdump/ (bin/pg-load-dump: a fresh cluster with the restored password).
# Dumps of an older PostgreSQL major version (backups of 1.2.0 and earlier
# were made with PostgreSQL 13) load into the current version the same way.

set -e -o pipefail
exec 1>&2

if [ ! -d pgdump ] || [ -z "$(ls -A pgdump 2>/dev/null)" ]; then
    echo "no state/pgdump in the restored state: skipping database restore"
    exit 0
fi

for spec in "arsnova-postgres-auth arsnovaauth ${PG_AUTH_USER:-arsnovaauth} postgres-auth.env" \
            "arsnova-postgres-comment arsnovacomment ${PG_COMMENT_USER:-arsnovacomment} postgres-comment.env"; do
    read -r volume db user secretfile <<<"${spec}"
    if [ -s "pgdump/${db}.pg_dump" ]; then
        pg-load-dump "${volume}" "${db}" "${user}" "${secretfile}" pgdump
    else
        echo "no dump for ${db}, skipped"
    fi
done
rm -rf pgdump
