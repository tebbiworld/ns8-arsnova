# Generate the secrets into state/passwords.env (mode 0600) and render the
# per-container secret files: they must not be stored in state/environment,
# which NS8 mirrors to Redis in plain text.

import secrets

import modsecrets
import servicesecrets

modsecrets.ensure({
    # Shared JWT secret: internal and public secrets are deliberately identical
    # so the gateway can re-sign tokens.
    "JWT_SECRET": secrets.token_hex(32),
    "COUCHDB_PASSWORD": secrets.token_hex(16),
    "PG_AUTH_PASSWORD": secrets.token_hex(16),
    "PG_COMMENT_PASSWORD": secrets.token_hex(16),
})
servicesecrets.render()
