# create-module runs once, right after the module user is created. Generate the
# long-lived secrets shared across the ARSnova microservices and persist them
# in the module environment for the systemd units to consume.


import agent

# Shared JWT signing secret. Every service that issues or validates tokens
# (core, authz, gateway, websocket, comment) must use the same value.

# CouchDB administrator (created on first start).
agent.set_env("COUCHDB_USER", "arsnova")

# PostgreSQL databases for the auth and comment services. The database names
# are fixed (referenced in the JDBC URLs); only the passwords are randomised.
agent.set_env("PG_AUTH_USER", "arsnovaauth")
agent.set_env("PG_COMMENT_USER", "arsnovacomment")

# Optional ARSnova administrator account (a registered user's e-mail address).
# Empty until set from the Settings page; an empty value matches no user.
agent.set_env("ADMIN_ACCOUNT", "")

# Self-registration: the registered (e-mail/password) provider only allows a
# new sign-up when the address matches one of these domain patterns. "*" means
# anyone may register (default). The Settings page can switch this to a
# non-matching sentinel to block new registrations while keeping login working.
agent.set_env("REGISTERED_ALLOWED_DOMAINS", "*")

# Persist the environment for the systemd units.
