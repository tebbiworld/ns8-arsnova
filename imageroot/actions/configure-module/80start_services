set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# Ensure the SMTP env file exists before the core unit references it
touch smarthost.env

# Refresh mail settings from the cluster smarthost (or the manual relay)
runagent discover-smarthost || true

# Enable the whole stack. The main unit owns the podman network; the service
# units are bound to it and started in dependency order.
units=(
    arsnova.service
    arsnova-couchdb.service
    arsnova-postgres-auth.service
    arsnova-postgres-comment.service
    arsnova-rabbitmq.service
    arsnova-authz.service
    arsnova-core.service
    arsnova-comments.service
    arsnova-websocket.service
    arsnova-formatting.service
    arsnova-web.service
    arsnova-gateway.service
    arsnova-proxy.service
)
systemctl --user enable "${units[@]}"

# A changed pasta option (node loopback for a user domain, see
# pypkg/arsnovaldap.py) applies only to a new rootless network, which podman
# creates when the first container starts after all of them stopped.
if [[ -f .netns-restart ]]; then
    echo "rootless network options changed: stopping every container first"
    systemctl --user stop "${units[@]}"
    rm -f .netns-restart
fi

# (Re)start the whole stack so configuration changes are applied. The units are
# restarted as a set (systemd orders them by their After= dependencies); the
# network unit only Wants its containers, so it is restarted explicitly here
# rather than relying on a cascade.
systemctl --user restart "${units[@]}"
