import os
import sys
import json

import agent
import arsnovaldap
import ldapsettings

config = {}

config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"

route = agent.get_route(os.environ["MODULE_ID"])
config["lets_encrypt"] = route.get("lets_encrypt", False)

config["public_url"] = os.getenv("ARSNOVA_ROOT_URL", "")
config["admin_email"] = os.getenv("ADMIN_ACCOUNT", "")
config["allow_registration"] = os.getenv("REGISTERED_ALLOWED_DOMAINS", "*") == "*"
config["smtp_host"] = os.getenv("SMTP_MANUAL_HOST", "")
config["smtp_from"] = os.getenv("SMTP_MANUAL_FROM", "")

# Directory login: ldap_* settings and the user domains of the cluster, never
# the bind password (only ldap_bind_password_set).
config["ldap_enabled"] = arsnovaldap.enabled()
config["ldap_title"] = os.getenv("LDAP_TITLE", "AD")
config.update(ldapsettings.configuration())

json.dump(config, fp=sys.stdout)
