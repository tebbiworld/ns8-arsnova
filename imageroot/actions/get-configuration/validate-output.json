{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/arsnova/get-configuration-output.json",
    "description": "Get arsnova configuration",
    "type": "object",
    "properties": {
        "host": { "type": "string" },
        "http2https": { "type": "boolean" },
        "lets_encrypt": { "type": "boolean" },
        "public_url": { "type": "string" },
        "admin_email": { "type": "string" },
        "allow_registration": { "type": "boolean" },
        "smtp_host": { "type": "string" },
        "smtp_from": { "type": "string" },
        "ldap_enabled": { "type": "boolean" },
        "ldap_url": { "type": "string" },
        "ldap_base_dn": { "type": "string" },
        "ldap_bind_dn": { "type": "string" },
        "ldap_bind_password_set": { "type": "boolean" },
        "ldap_source": { "type": "string", "enum": ["domain", "custom"] },
        "ldap_domain": { "type": "string" },
        "ldap_start_tls": { "type": "boolean" },
        "ldap_tls_verify": { "type": "boolean" },
        "ldap_schema": { "type": "string", "enum": ["ad", "rfc2307"] },
        "user_domains": { "type": "array", "items": { "type": "string" } },
        "ldap_group": { "type": "string" },
        "ldap_user_attribute": { "type": "string" },
        "ldap_title": { "type": "string" }
    },
    "not": { "required": ["ldap_bind_password"] }
}
